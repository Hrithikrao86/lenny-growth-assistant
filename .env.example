# Database is provided by Docker Compose; keep this unless using a hosted Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant

# Ollama running on the Windows host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional cloud provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ollama | claude | claude_agent
DEFAULT_PROVIDER=ollama

SIMILARITY_THRESHOLD=0.55
RETRIEVAL_TOP_K=5
MAX_HISTORY_MESSAGES=12
LOG_LEVEL=INFO
TRANSCRIPT_GLOB=data/transcripts/**/transcript.md
